[Desktop Entry]
Type=Application
Name=Skykeep
GenericName=iCloud Client
Comment=Your iCloud, on this computer
Exec=skykeep %U
Icon=io.github.yashwanthkamireddi.Skykeep
Terminal=false
Categories=Office;Calendar;ContactManagement;
Keywords=iCloud;calendar;reminders;notes;contacts;sync;
MimeType=text/calendar;text/vcard;text/x-vcard;
StartupNotify=true
StartupWMClass=io.github.yashwanthkamireddi.Skykeep
Actions=new-reminder;new-note;notes;reminders;calendar;contacts;drive;photos;

[Desktop Action new-reminder]
Name=New Reminder
Exec=skykeep --new reminder

[Desktop Action new-note]
Name=New Note
Exec=skykeep --new note

[Desktop Action notes]
Name=Notes
Exec=skykeep --app notes

[Desktop Action reminders]
Name=Reminders
Exec=skykeep --app reminders

[Desktop Action calendar]
Name=Calendar
Exec=skykeep --app calendar

[Desktop Action contacts]
Name=Contacts
Exec=skykeep --app contacts

[Desktop Action drive]
Name=Drive
Exec=skykeep --app drive

[Desktop Action photos]
Name=Photos
Exec=skykeep --app photos
